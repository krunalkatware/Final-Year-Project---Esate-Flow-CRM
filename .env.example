# EstateFlow — Enterprise Production Environment Configuration Template
# Copy this file to .env and configure appropriate values for your deployment.

# ── Database Configuration ───────────────────────────────────────────────────
# PostgreSQL in production (e.g. postgresql://user:pass@host:5432/estateflow)
# SQLite for local testing (e.g. sqlite:///./estateflow.db)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/estateflow

# ── Security & Authentication ────────────────────────────────────────────────
SECRET_KEY=estateflow-super-secret-jwt-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Google OAuth 2.0 ─────────────────────────────────────────────────────────
# Obtain from Google Cloud Console > APIs & Services > Credentials
# When unset, the server informs users that Google Sign-in is not configured.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── Razorpay Payment Gateway ─────────────────────────────────────────────────
# Obtain from Razorpay Dashboard > Settings > API Keys
# When unset, the payment gateway informs callers that production keys are required.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Server & CORS Configuration ──────────────────────────────────────────────
ENVIRONMENT=development  # development | production
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ── Frontend Configuration (Client .env) ─────────────────────────────────────
# VITE_API_URL=http://localhost:8000/api

